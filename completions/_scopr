#compdef scopr

# Completion for scopr. Install by putting this file on your fpath as _scopr,
# or run: scopr completion zsh > ~/.zfunc/_scopr
#
# It asks the scopr binary for candidates, so it stays correct as commands
# change. An old or missing binary yields no completions rather than errors.

_scopr() {
  (( $+commands[scopr] )) || return 1

  local -a words_to_complete
  words_to_complete=("${(@)words[2,CURRENT]}")

  local raw
  raw="$(scopr __complete --protocol 1 -- "${(@)words_to_complete}" 2>/dev/null)" || return 1
  [[ -n $raw ]] || return 1

  local -a lines
  lines=("${(@f)raw}")

  local -A grouped
  local -i directive=0
  local line value desc group

  for line in "${lines[@]}"; do
    if [[ $line == ':'<-> ]]; then
      directive=${line#:}
      continue
    fi

    value=${line%%$'\t'*}
    [[ -n $value ]] || continue

    line=${line#*$'\t'}
    desc=${line%%$'\t'*}
    group=${line#*$'\t'}
    [[ -n $group ]] || group=candidates

    grouped[$group]+="${value//:/\\:}:${desc}"$'\n'
  done

  local -i shown=0
  for group in "${(@k)grouped}"; do
    local -a entries
    entries=("${(@f)${grouped[$group]%$'\n'}}")
    (( ${#entries} )) || continue
    _describe -t "$group" "$group" entries && shown=1
  done

  if (( directive & 1 )); then
    _files && shown=1
  fi

  return $(( ! shown ))
}

_scopr "$@"
