#compdef scopr

# Completion for scopr. Put this file on your fpath as _scopr.
#
# Candidates come from the binary, so an old or missing scopr yields no
# completions rather than errors.

_scopr() {
  (( $+commands[scopr] )) || return 1

  local -a words_to_complete
  words_to_complete=("${(@)words[2,CURRENT]}")

  local raw
  raw="$(scopr __complete --protocol 2 -- "${(@)words_to_complete}" 2>/dev/null)" || return 1
  [[ -n $raw ]] || return 1

  local -a lines
  lines=("${(@f)raw}")

  local -A grouped quoted
  local -i directive=0
  local line value desc group raw

  for line in "${lines[@]}"; do
    if [[ $line == ':'<-> ]]; then
      directive=${line#:}
      continue
    fi

    value=${line%%$'\t'*}
    [[ -n $value ]] || continue

    line=${line#*$'\t'}
    desc=${line%%$'\t'*}
    line=${line#*$'\t'}
    group=${line%%$'\t'*}
    raw=${line#*$'\t'}
    [[ -n $group ]] || group=candidates

    if [[ $raw == raw ]]; then
      quoted[$group]+="${value//:/\\:}:${desc}"$'\n'
    else
      grouped[$group]+="${value//:/\\:}:${desc}"$'\n'
    fi
  done

  local -i shown=0
  local -a entries
  for group in "${(@k)grouped}"; do
    entries=("${(@f)${grouped[$group]%$'\n'}}")
    (( ${#entries} )) || continue
    _describe -t "$group" "$group" entries && shown=1
  done
  for group in "${(@k)quoted}"; do
    entries=("${(@f)${quoted[$group]%$'\n'}}")
    (( ${#entries} )) || continue
    _describe -t "$group" "$group" entries -Q && shown=1
  done

  if (( directive & 1 )); then
    _files && shown=1
  fi

  return $(( ! shown ))
}

# Autoloaded from fpath, zsh calls the file itself; sourced directly, it has to
# register instead.
if [[ $funcstack[1] == _scopr ]]; then
  _scopr "$@"
else
  compdef _scopr scopr
fi
